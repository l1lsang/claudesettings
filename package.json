{
  "name": "idea-arena",
  "version": "0.1.0",
  "private": true,
  "description": "IDEA ARENA — 여러 Claude 에이전트가 아이디어를 독립 생성·익명 심사·토론·개선하는 로컬 연구 도구",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "arena": "tsx src/cli/index.ts",
    "dashboard": "tsx src/cli/index.ts serve",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
